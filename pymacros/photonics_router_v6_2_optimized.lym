<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
<description>Photonics Router v6.2 - Bend-aware Router with Tangent Check</description>
<version>6.2</version>
<category>Photonics</category>
<autorun>true</autorun>
<autorun-early>false</autorun-early>
<show-in-menu>false</show-in-menu>
<interpreter>python</interpreter>
<text><![CDATA[
import pya
import math

WG_LAYER = pya.LayerInfo(1, 0)
PIN_LAYER = pya.LayerInfo(2, 0)
WG_WIDTH = 0.5
SNAP_RADIUS = 4.0
MIN_LEAD = 4.0
MAX_LEAD = 20.0
NPTS = 96
CONNECT_TOL = 0.15  # um
MIN_BEND_RADIUS = 5.0  # um, prototype design rule
MAX_TANGENT_ERROR_DEG = 5.0  # allowed port/route tangent error
BEND_OPT_MAX_ITER = 12
BEND_OPT_STEP = 1.15

class PhotonicDevice:
    """Photonic device containing native optical ports."""
    def __init__(self, name, cell_name):
        self.name = name
        self.cell_name = cell_name
        self.ports = []

    def add_port(self, port):
        if port not in self.ports:
            self.ports.append(port)
        port.device = self

    def __repr__(self):
        return "PhotonicDevice(%s, type=%s, ports=%d)" % (
            self.name, self.cell_name, len(self.ports))

class OpticalPort:
    """Optical-port metadata including owning instance identification."""
    def __init__(self, name, position, direction, width=WG_WIDTH,
                 instance_name=None, cell_name=None):
        self.name = name
        self.position = position
        self.direction = direction
        self.width = width
        self.instance_name = instance_name
        self.cell_name = cell_name

        # v6.1 photonic data model
        self.device = None
        self.net = None

    @property
    def qualified_name(self):
        if self.device is not None:
            return "%s.%s" % (self.device.name, self.name)
        if self.instance_name:
            return "%s.%s" % (self.instance_name, self.name)
        return self.name

    def __repr__(self):
        return "OpticalPort(%s, x=%.3f, y=%.3f, width=%.3f)" % (
            self.qualified_name, self.position.x, self.position.y, self.width)

def unit(dx, dy):
    d = math.hypot(dx, dy)
    return None if d < 1e-12 else (dx/d, dy/d)

def dist(a, b):
    return math.hypot(a.x-b.x, a.y-b.y)

def dot(a, b):
    return a[0]*b[0] + a[1]*b[1]

def path_points(path, dbu):
    pts = []
    for q in path.each_point():
        if isinstance(q, pya.DPoint):
            pts.append(q)
        else:
            pts.append(pya.DPoint(q.x*dbu, q.y*dbu))
    return pts

def _safe_cell_name(cell):
    try:
        name = str(cell.name)
    except Exception:
        name = "device"
    # PCell variant names can contain generated suffixes. Keep the visible
    # cell name but remove whitespace so it is convenient in messages.
    return "".join(name.split()) or "device"

def collect_pin_objects(cell, layout, trans=None, result=None,
                        owner=None, cell_name=None):
    """Collect PIN_LAYER paths/texts recursively with instance ownership."""
    if result is None:
        result = {"paths": [], "texts": []}
    if trans is None:
        trans = pya.DCplxTrans()
    if cell_name is None:
        cell_name = _safe_cell_name(cell)

    li = layout.layer(PIN_LAYER)

    for sh in cell.shapes(li).each():
        try:
            if sh.is_path():
                pts = path_points(sh.path, layout.dbu)
                pts = [trans * q for q in pts]
                if len(pts) >= 2:
                    width = sh.path.width * layout.dbu
                    result["paths"].append(
                        (pts, width, owner, cell_name))
            elif sh.is_text():
                t = sh.text
                try:
                    tp = pya.DPoint(t.trans.disp.x * layout.dbu,
                                    t.trans.disp.y * layout.dbu)
                except Exception:
                    tp = pya.DPoint(t.x * layout.dbu, t.y * layout.dbu)
                result["texts"].append(
                    (str(t.string), trans * tp, owner, cell_name))
        except Exception:
            pass

    # Assign a stable, readable identifier to each child instance in this
    # hierarchy level. This does not modify the layout.
    counters = {}
    try:
        for inst in cell.each_inst():
            child = layout.cell(inst.cell_index)
            base = _safe_cell_name(child)
            counters[base] = counters.get(base, 0) + 1
            local_name = "%s[%d]" % (base, counters[base])
            inst_name = local_name if owner is None else "%s/%s" % (
                owner, local_name)

            try:
                it = inst.dcplx_trans
            except Exception:
                it = pya.DCplxTrans(inst.trans)

            collect_pin_objects(
                child, layout, trans * it, result,
                inst_name, base)
    except Exception:
        pass

    return result

def collect_ports(cell, layout):
    """Build native PCell ports and preserve their owning instance."""
    objects = collect_pin_objects(cell, layout)
    paths = objects["paths"]
    texts = objects["texts"]
    ports = []
    match_radius = max(1.5, SNAP_RADIUS)

    for name, label_pos, owner, text_cell_name in texts:
        best = None
        best_d = match_radius

        # Prefer a pin path belonging to the same instance as the label.
        for pts, width, path_owner, path_cell_name in paths:
            if path_owner != owner:
                continue
            for endpoint, inner in ((pts[0], pts[1]), (pts[-1], pts[-2])):
                d = dist(label_pos, endpoint)
                if d <= best_d:
                    best_d = d
                    best = (endpoint, inner, width, path_cell_name)

        if best is None:
            continue

        endpoint, inner, width, path_cell_name = best
        direction = unit(endpoint.x-inner.x, endpoint.y-inner.y)
        if direction is None:
            continue

        ports.append(OpticalPort(
            name, endpoint, direction, width,
            instance_name=owner,
            cell_name=path_cell_name))

    return ports

def nearest_port(cell, layout, click):
    best = None
    bd = SNAP_RADIUS

    for port in collect_ports(cell, layout):
        d = dist(click, port.position)
        if d <= bd:
            bd = d
            best = port
    return best

def polyline_length(pts):
    return sum(dist(pts[i-1], pts[i]) for i in range(1, len(pts)))

def cubic(p0, c0, c1, p1, n):
    out = []
    for i in range(n+1):
        t = float(i)/n
        u = 1.0-t
        out.append(pya.DPoint(
            u*u*u*p0.x + 3*u*u*t*c0.x + 3*u*t*t*c1.x + t*t*t*p1.x,
            u*u*u*p0.y + 3*u*u*t*c0.y + 3*u*t*t*c1.y + t*t*t*p1.y))
    return out

def polyline_has_loop(pts):
    # Fast sanity check: detect strong reversal of successive segments.
    prev = None
    reversals = 0
    for i in range(1, len(pts)):
        v = unit(pts[i].x-pts[i-1].x, pts[i].y-pts[i-1].y)
        if v is None:
            continue
        if prev is not None and dot(prev, v) < -0.15:
            reversals += 1
        prev = v
    return reversals > 0

def angle_between_deg(a, b):
    """Smallest angle between two direction vectors in degrees.

    unit() in this router returns a plain (x, y) tuple, so keep the
    tangent calculation tuple-based as well.
    """
    ua = unit(a[0], a[1])
    ub = unit(b[0], b[1])
    c = max(-1.0, min(1.0, dot(ua, ub)))
    return math.degrees(math.acos(c))


def route_endpoint_tangent_errors(pts, d0, d1):
    """Return tangent errors at source and destination ports.

    d0/d1 are native port directions.  The route tangent must leave the
    source along its port axis and arrive at the destination along its
    port axis.  Axis direction is compared bidirectionally because native
    pin orientation may be stored with either sign.
    """
    if len(pts) < 2:
        return 180.0, 180.0

    t0 = unit(pts[1].x - pts[0].x, pts[1].y - pts[0].y)
    t1 = unit(pts[-1].x - pts[-2].x, pts[-1].y - pts[-2].y)

    def axis_error(t, d):
        # Native port directions are also tuple-based in v6.1/v6.2.
        e1 = angle_between_deg(t, d)
        e2 = angle_between_deg(t, (-d[0], -d[1]))
        return min(e1, e2)

    return axis_error(t0, d0), axis_error(t1, d1)


def tangent_check(pts, d0, d1, tolerance=MAX_TANGENT_ERROR_DEG):
    e0, e1 = route_endpoint_tangent_errors(pts, d0, d1)
    return e0, e1, (e0 <= tolerance and e1 <= tolerance)


def local_bend_radius(a, b, c):
    """Circumcircle radius through three sampled points, in um."""
    ab = dist(a, b)
    bc = dist(b, c)
    ca = dist(c, a)

    if ab < 1e-12 or bc < 1e-12 or ca < 1e-12:
        return None

    area2 = abs(
        (b.x-a.x)*(c.y-a.y) -
        (b.y-a.y)*(c.x-a.x)
    )

    # Nearly collinear points are effectively straight.
    if area2 < 1e-12:
        return None

    return (ab * bc * ca) / (2.0 * area2)


def minimum_bend_radius(pts):
    """Minimum sampled local bend radius. Straight routes return infinity."""
    rmin = float("inf")
    for i in range(1, len(pts)-1):
        r = local_bend_radius(pts[i-1], pts[i], pts[i+1])
        if r is not None and r < rmin:
            rmin = r
    return rmin


def bend_radius_check(pts, required=MIN_BEND_RADIUS):
    rmin = minimum_bend_radius(pts)
    return rmin, rmin >= required


def format_bend_radius(r):
    if math.isinf(r):
        return "INF"
    return "%.3f um" % r


def _route_points_with_lead(p0, p1, d0, d1, lead):
    """Generate one tangent-constrained cubic Bezier using a chosen lead."""
    vx = p1.x - p0.x
    vy = p1.y - p0.y
    D = math.hypot(vx, vy)

    if D < 1e-9:
        return [p0, p1]

    u01 = unit(vx, vy)

    # Preserve the v6.1 direction-sign convention: each port axis is oriented
    # toward the opposite endpoint before building the Bezier controls.
    if dot(d0, u01) < 0:
        d0 = (-d0[0], -d0[1])
    if dot(d1, (-u01[0], -u01[1])) < 0:
        d1 = (-d1[0], -d1[1])

    c0 = pya.DPoint(p0.x + d0[0] * lead, p0.y + d0[1] * lead)
    c1 = pya.DPoint(p1.x + d1[0] * lead, p1.y + d1[1] * lead)
    return cubic(p0, c0, c1, p1, NPTS)


def optimize_bend_aware_route(p0, p1, d0, d1):
    """Try progressively larger Bezier leads and keep the best legal route.

    Returns:
      pts, rmin, bend_ok, tangent_error_src, tangent_error_dst,
      tangent_ok, geometry_ok, iterations, optimized
    """
    vx = p1.x - p0.x
    vy = p1.y - p0.y
    D = math.hypot(vx, vy)

    base_lead = max(MIN_LEAD, min(MAX_LEAD, 0.28 * D))

    # Candidate 0 is the proven v6.1 route.  Additional candidates increase
    # tangent lead while remaining bounded by MAX_LEAD.
    candidates = []
    lead = base_lead
    for i in range(BEND_OPT_MAX_ITER):
        candidates.append(min(lead, MAX_LEAD))
        if lead >= MAX_LEAD - 1e-12:
            break
        lead *= BEND_OPT_STEP

    best = None

    for i, lead in enumerate(candidates):
        if i == 0:
            pts = route_points(p0, p1, d0, d1)
        else:
            pts = _route_points_with_lead(p0, p1, d0, d1, lead)

        # Reject obviously pathological candidates.
        if polyline_has_loop(pts):
            continue

        plen = polyline_length(pts)
        if D > 1e-9 and plen > 1.80 * D:
            continue

        rmin, bend_ok = bend_radius_check(pts)
        e0, e1, tangent_ok = tangent_check(pts, d0, d1)
        geometry_ok = bend_ok and tangent_ok

        # Prefer legal geometry. Otherwise retain the candidate with the
        # largest minimum bend radius; shorter length breaks ties.
        score = (1 if geometry_ok else 0, rmin, -plen)
        if best is None or score > best[0]:
            best = (score, pts, rmin, bend_ok, e0, e1,
                    tangent_ok, geometry_ok, i + 1, i > 0)

        if geometry_ok:
            break

    if best is None:
        pts = route_points(p0, p1, d0, d1)
        rmin, bend_ok = bend_radius_check(pts)
        e0, e1, tangent_ok = tangent_check(pts, d0, d1)
        return (pts, rmin, bend_ok, e0, e1, tangent_ok,
                bend_ok and tangent_ok, 1, False)

    return best[1:]


def route_points(p0, p1, d0, d1):
    """
    v5.5 routing core (inherited from v5.4):
      * automatically scale lead length with port spacing
      * prefer directions that point toward the opposite port
      * if a single cubic looks folded, fall back to a midpoint route
    """
    D = dist(p0, p1)
    if D < 1e-9:
        return [p0, p1]

    toward01 = unit(p1.x-p0.x, p1.y-p0.y)
    toward10 = (-toward01[0], -toward01[1])

    # A physical connection leaves each optical interface into free routing
    # space.  Depending on how the PCell pin path was drawn, the detected
    # vector can be reversed. Choose the sign which points more toward the
    # other endpoint. This prevents the common large-loop case.
    if dot(d0, toward01) < dot((-d0[0], -d0[1]), toward01):
        d0 = (-d0[0], -d0[1])
    if dot(d1, toward10) < dot((-d1[0], -d1[1]), toward10):
        d1 = (-d1[0], -d1[1])

    lead = max(MIN_LEAD, min(MAX_LEAD, 0.28*D))

    c0 = pya.DPoint(p0.x + lead*d0[0], p0.y + lead*d0[1])
    # Endpoint derivative is p1-c1, therefore c1 lies opposite the
    # desired arrival tangent.
    c1 = pya.DPoint(p1.x + lead*d1[0], p1.y + lead*d1[1])

    pts = cubic(p0, c0, c1, p1, NPTS)

    # Additional geometric guard: an excessive route length usually means
    # the cubic is making an unwanted detour/loop.
    plen = sum(dist(pts[i-1], pts[i]) for i in range(1, len(pts)))
    if not polyline_has_loop(pts) and plen <= 1.65*D:
        return pts

    # Fallback: two smooth cubic sections through a neutral midpoint.
    # This avoids forcing incompatible endpoint tangents into one cubic.
    mid = pya.DPoint((p0.x+p1.x)/2.0, (p0.y+p1.y)/2.0)
    md = toward01
    half = max(MIN_LEAD, min(MAX_LEAD, 0.18*D))

    a0 = pya.DPoint(p0.x + half*d0[0], p0.y + half*d0[1])
    a1 = pya.DPoint(mid.x - half*md[0], mid.y - half*md[1])
    b0 = pya.DPoint(mid.x + half*md[0], mid.y + half*md[1])
    b1 = pya.DPoint(p1.x + half*d1[0], p1.y + half*d1[1])

    left = cubic(p0, a0, a1, mid, NPTS//2)
    right = cubic(mid, b0, b1, p1, NPTS//2)
    return left + right[1:]


def collect_waveguide_paths(cell, layout, trans=None, result=None):
    """Collect WG_LAYER paths recursively in top-cell coordinates."""
    if result is None:
        result = []
    if trans is None:
        trans = pya.DCplxTrans()

    li = layout.layer(WG_LAYER)
    for sh in cell.shapes(li).each():
        try:
            if sh.is_path():
                pts = path_points(sh.path, layout.dbu)
                pts = [trans * q for q in pts]
                if len(pts) >= 2:
                    result.append(pts)
        except Exception:
            pass

    try:
        for inst in cell.each_inst():
            child = layout.cell(inst.cell_index)
            try:
                it = inst.dcplx_trans
            except Exception:
                it = pya.DCplxTrans(inst.trans)
            collect_waveguide_paths(child, layout, trans * it, result)
    except Exception:
        pass
    return result

class PhotonicNet:
    """Extracted photonic net connecting optical ports."""
    def __init__(self, name, ports, length=0.0, min_bend_radius=None,
                 required_bend_radius=MIN_BEND_RADIUS):
        self.name = name
        self.ports = list(ports)
        self.length = length
        self.min_bend_radius = min_bend_radius
        self.required_bend_radius = required_bend_radius
        self.bend_check = (
            None if min_bend_radius is None
            else min_bend_radius >= required_bend_radius
        )

        # v6.1+: establish Port <-> Net relationship
        for port in self.ports:
            port.net = self

    def __repr__(self):
        return "PhotonicNet(%s, ports=%s, length=%.3f)" % (
            self.name,
            [p.qualified_name for p in self.ports],
            self.length)

def ports_at_point(ports, point, tol=CONNECT_TOL):
    return [p for p in ports if dist(p.position, point) <= tol]

def extract_connection_pairs(cell, layout):
    """Extract routed optical-port pairs from WG path endpoints."""
    ports = collect_ports(cell, layout)
    wg_paths = collect_waveguide_paths(cell, layout)
    pairs = []
    seen = set()

    for pts in wg_paths:
        if len(pts) < 2:
            continue
        a_ports = ports_at_point(ports, pts[0])
        b_ports = ports_at_point(ports, pts[-1])

        for a in a_ports:
            for b in b_ports:
                if a is b or a.instance_name == b.instance_name:
                    continue
                names = tuple(sorted((a.qualified_name, b.qualified_name)))
                if names in seen:
                    continue
                seen.add(names)
                pairs.append((a, b, polyline_length(pts)))

    return ports, pairs

def build_photonic_devices(ports):
    """Build PhotonicDevice objects and link them to OpticalPort objects."""
    devices = {}
    for p in ports:
        if not p.instance_name:
            continue
        if p.instance_name not in devices:
            devices[p.instance_name] = PhotonicDevice(
                p.instance_name, p.cell_name)
        devices[p.instance_name].add_port(p)
    return devices

def extract_photonic_netlist(cell, layout):
    """Build PhotonicDevice -> OpticalPort -> PhotonicNet relationships."""
    ports, pairs = extract_connection_pairs(cell, layout)

    # Build Device <-> Port relationships first.
    devices = build_photonic_devices(ports)

    # Then build Port <-> Net relationships.
    nets = []
    for i, (a, b, length) in enumerate(pairs, 1):
        nets.append(PhotonicNet("NET%d" % i, [a, b], length))

    return ports, devices, nets

def verify_connectivity(cell, layout):
    ports, devices, nets = extract_photonic_netlist(cell, layout)
    connected_names = set()
    for net in nets:
        for p in net.ports:
            connected_names.add(p.qualified_name)

    connected = [p for p in ports if p.qualified_name in connected_names]
    unconnected = [p for p in ports if p.qualified_name not in connected_names]
    return connected, unconnected, devices, nets

def netlist_report(cell, layout):
    connected, unconnected, devices, nets = verify_connectivity(cell, layout)

    lines = [
        "[Photonics Router v6.2 Photonic Data Model]",
        "Devices: %d" % len(devices),
        "Nets: %d" % len(nets),
        "Connected ports: %d" % len(connected),
        "Unconnected ports: %d" % len(unconnected),
        "",
        "DEVICES",
    ]

    for inst_name in sorted(devices):
        device = devices[inst_name]
        lines.append("  DEVICE %s  TYPE %s" % (
            device.name, device.cell_name))

    if nets:
        lines.append("")
        lines.append("NETLIST")
        for net in nets:
            lines.append("  NET %s" % net.name)
            for p in net.ports:
                lines.append("    PORT %s" % p.qualified_name)
            lines.append("    LENGTH %.3f um" % net.length)

    if unconnected:
        lines.append("")
        lines.append("UNCONNECTED")
        for p in unconnected:
            lines.append("  --  %s" % p.qualified_name)

    return "\n".join(lines)

# Compatibility name used by the Router UI.
def connectivity_report(cell, layout):
    return netlist_report(cell, layout)

class Router(pya.Plugin):
    def __init__(self):
        super(Router, self).__init__()
        self.first = None

    def activated(self):
        self.first = None
        try:
            pya.MainWindow.instance().message(
                "Photonics Router v6.2 - click source port", 2500)
        except Exception:
            pass

    def deactivated(self):
        self.first = None

    def mouse_click_event(self, p, buttons, prio):
        if prio:
            return False

        view = pya.LayoutView.current()
        if view is None:
            return False
        cv = view.active_cellview()
        if cv is None or not cv.is_valid():
            return False

        layout = cv.layout()
        cell = cv.cell
        click = pya.DPoint(p.x, p.y)
        port = nearest_port(cell, layout, click)

        if port is None:
            try:
                pya.MainWindow.instance().message(
                    "No optical port found within %.1f um" % SNAP_RADIUS, 2200)
            except Exception:
                pass
            return True

        if self.first is None:
            self.first = port
            try:
                pya.MainWindow.instance().message(
                    "Source %s selected - click destination" % port.qualified_name, 2200)
            except Exception:
                pass
            return True

        src = self.first
        dst = port
        self.first = None

        p0, d0 = src.position, src.direction
        p1, d1 = dst.position, dst.direction
        (pts, route_rmin, route_bend_ok,
         tangent_err_src, tangent_err_dst, route_tangent_ok,
         route_geometry_ok, opt_iterations, route_optimized) = (
            optimize_bend_aware_route(p0, p1, d0, d1)
        )
        wg_width = min(src.width, dst.width)
        cell.shapes(layout.layer(WG_LAYER)).insert(pya.DPath(pts, wg_width))
        wg_length = polyline_length(pts)

        try:
            view.add_missing_layers()
        except Exception:
            pass

        msg = (
            "[Photonics Router v6.2]\n"
            "%s -> %s\n"
            "Length = %.3f um\n"
            "\n[Bend-aware Routing]\n"
            "Required minimum radius = %.3f um\n"
            "Actual minimum radius   = %s\n"
            "Bend-radius check       = %s\n"
            "Source tangent error    = %.3f deg\n"
            "Destination tangent err = %.3f deg\n"
            "Tangent check           = %s\n"
            "Geometry check          = %s\\n"
            "Optimization           = %s\\n"
            "Optimization iterations= %d" % (
                src.qualified_name, dst.qualified_name, wg_length,
                MIN_BEND_RADIUS, format_bend_radius(route_rmin),
                "PASS" if route_bend_ok else "FAIL",
                tangent_err_src, tangent_err_dst,
                "PASS" if route_tangent_ok else "FAIL",
                "PASS" if route_geometry_ok else "FAIL",
                "APPLIED" if route_optimized else "NOT NEEDED",
                opt_iterations)
        )

        # Python console output (Macro Development -> Console -> Python)
        print(msg)

        report = connectivity_report(cell, layout)
        print(report)

        # KLayout status bar
        try:
            pya.MainWindow.instance().message(
                "Waveguide %s -> %s created | Length = %.3f um | Rmin = %s | Geometry %s" % (
                    src.qualified_name, dst.qualified_name, wg_length,
                    format_bend_radius(route_rmin),
                    "PASS" if route_geometry_ok else "FAIL"), 5000)
        except Exception:
            pass

        # Visible confirmation dialog
        try:
            pya.MessageBox.info(
                "Photonics Router v6.2",
                "Waveguide %s -> %s created\n\n"
                "Length = %.3f um\n\n"
                "[Bend-aware Routing]\n"
                "Required minimum radius = %.3f um\n"
                "Actual minimum radius   = %s\n"
                "Bend-radius check       = %s\n"
                "Source tangent error    = %.3f deg\n"
                "Destination tangent err = %.3f deg\n"
                "Tangent check           = %s\n"
                "Geometry check          = %s\n\n%s" % (
                    src.qualified_name, dst.qualified_name, wg_length,
                    MIN_BEND_RADIUS, format_bend_radius(route_rmin),
                    "PASS" if route_bend_ok else "FAIL",
                    tangent_err_src, tangent_err_dst,
                    "PASS" if route_tangent_ok else "FAIL",
                    "PASS" if route_geometry_ok else "FAIL",
                    "APPLIED" if route_optimized else "NOT NEEDED",
                    opt_iterations,
                    connectivity_report(cell, layout)),
                pya.MessageBox.Ok)
        except Exception as ex:
            print("MessageBox error: %s" % ex)

        return True

class RouterFactory(pya.PluginFactory):
    def __init__(self):
        super(RouterFactory, self).__init__()
        self.register(-1000, "photonics_router_v6_2",
                      "Photonics Router v6.2")

    def create_plugin(self, manager, root, view):
        return Router()

RouterFactory()
]]></text>
</klayout-macro>
