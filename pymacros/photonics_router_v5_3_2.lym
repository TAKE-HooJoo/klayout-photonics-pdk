<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>Photonics Router v5.3.2 - KLayout 0.30.9 direction-aware routing</description>
 <version>5.3.2</version><category>pymacros</category><prolog/><epilog/><doc/>
 <autorun>true</autorun><autorun-early>false</autorun-early><shortcut/>
 <show-in-menu>false</show-in-menu><group-name/><menu-path/>
 <interpreter>python</interpreter><dsl-interpreter-name/>
 <text># Photonics Router v5.3.2 for KLayout 0.30.9
# Rebuilt: no indexed Path point API is used.
import pya, math

WG_LAYER=pya.LayerInfo(1,0)
PIN_LAYER=pya.LayerInfo(2,0)
WG_WIDTH=0.5
SNAP_RADIUS=4.0
LEAD=8.0
NPTS=80

def qi(v,dbu): return int(round(v/dbu))

def unit(dx,dy):
    d=math.hypot(dx,dy)
    if d &lt; 1e-12: return (1.0,0.0)
    return (dx/d,dy/d)

def curve(a,c1,c2,b):
    out=[]
    for i in range(NPTS+1):
        t=i/float(NPTS); u=1.0-t
        out.append((
            u*u*u*a[0]+3*u*u*t*c1[0]+3*u*t*t*c2[0]+t*t*t*b[0],
            u*u*u*a[1]+3*u*u*t*c1[1]+3*u*t*t*c2[1]+t*t*t*b[1]))
    return out

def current():
    v=pya.Application.instance().main_window().current_view()
    if v is None: return None,None,None
    cv=v.active_cellview()
    if cv is None or not cv.is_valid(): return v,None,None
    return v,cv.layout(),cv.cell

def pins(cell,ly):
    li=ly.layer(PIN_LAYER)
    dbu=ly.dbu
    out=[]
    it=cell.begin_shapes_rec(li)
    while not it.at_end():
        sh=it.shape()
        if sh.is_path():
            # Shape.each_point is documented for path shapes.
            pts=list(sh.each_point())
            if len(pts)&gt;=2:
                tr=it.trans()
                a=tr*pts[0]
                b=tr*pts[-1]
                ax,ay=a.x*dbu,a.y*dbu
                bx,by=b.x*dbu,b.y*dbu
                ua=unit(ax-bx,ay-by)
                ub=unit(bx-ax,by-ay)
                out.append((ax,ay,ua[0],ua[1]))
                out.append((bx,by,ub[0],ub[1]))
        it.next()
    return out

def snap(x,y,cell,ly):
    hit=None
    best=SNAP_RADIUS
    for px,py,ux,uy in pins(cell,ly):
        d=math.hypot(px-x,py-y)
        if d&lt;=best:
            hit=(px,py,ux,uy,True)
            best=d
    return hit if hit is not None else (x,y,0.0,0.0,False)

def draw(a,b,ly,cell):
    x1,y1,u1x,u1y,s1=a
    x2,y2,u2x,u2y,s2=b
    if not s1: u1x,u1y=unit(x2-x1,0.0)
    if not s2: u2x,u2y=unit(x1-x2,0.0)
    d=math.hypot(x2-x1,y2-y1)
    lead=min(LEAD,max(2.0,d*0.22))
    c1=(x1+u1x*lead,y1+u1y*lead)
    c2=(x2+u2x*lead,y2+u2y*lead)
    pts=curve((x1,y1),c1,c2,(x2,y2))
    ip=[pya.Point(qi(x,ly.dbu),qi(y,ly.dbu)) for x,y in pts]
    cell.shapes(ly.layer(WG_LAYER)).insert(
        pya.Path(ip,qi(WG_WIDTH,ly.dbu)))

class Router532(pya.Plugin):
    def __init__(self):
        super(Router532,self).__init__()
        self.first=None
    def activated(self):
        self.first=None
    def deactivated(self):
        self.first=None
    def mouse_click_event(self,p,buttons,prio):
        if not prio: return False
        view,ly,cell=current()
        if ly is None or cell is None: return True
        q=snap(p.x,p.y,cell,ly)
        if self.first is None:
            self.first=q
        else:
            a=self.first
            self.first=None
            draw(a,q,ly,cell)
            view.add_missing_layers()
            view.update_content()
        return True

class Factory532(pya.PluginFactory):
    def __init__(self):
        super(Factory532,self).__init__()
        self.register(100000,"openpdk::photonics_router_v532",
                      "Photonics Router v5.3.2")
    def create_plugin(self,manager,dispatcher,view):
        return Router532()

PHOTONICS_ROUTER_FACTORY_V532=Factory532()
</text>
</klayout-macro>
