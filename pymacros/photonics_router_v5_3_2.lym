<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
<description>Photonics Router v5.3.2</description>
<version>5.3.2</version>
<category>Photonics</category>
<autorun>true</autorun>
<autorun-early>false</autorun-early>
<show-in-menu>false</show-in-menu>
<interpreter>python</interpreter>
<text><![CDATA[
import pya
import math

WG_LAYER = pya.LayerInfo(1, 0)
PIN_LAYER = pya.LayerInfo(2, 0)
WG_WIDTH = 0.5
SNAP_RADIUS = 4.0
LEAD = 8.0
NPTS = 80

def unit(dx, dy):
    d = math.hypot(dx, dy)
    return None if d == 0 else (dx/d, dy/d)

def dist(a, b):
    return math.hypot(a.x-b.x, a.y-b.y)

def path_points(path, dbu):
    pts = []
    for q in path.each_point():
        if isinstance(q, pya.DPoint):
            pts.append(q)
        else:
            pts.append(pya.DPoint(q.x*dbu, q.y*dbu))
    return pts

def collect_pins(cell, layout, trans=None, result=None):
    if result is None: result = []
    if trans is None: trans = pya.DCplxTrans()
    li = layout.layer(PIN_LAYER)
    for s in cell.shapes(li).each():
        try:
            if not s.is_path(): continue
            pts = path_points(s.path, layout.dbu)
            pts = [trans * q for q in pts]
            if len(pts) >= 2: result.append(pts)
        except Exception:
            pass
    try:
        for inst in cell.each_inst():
            child = layout.cell(inst.cell_index)
            try:
                it = inst.dcplx_trans
            except Exception:
                it = pya.DCplxTrans(inst.trans)
            collect_pins(child, layout, trans * it, result)
    except Exception:
        pass
    return result

def nearest_port(cell, layout, click):
    best = None
    bd = SNAP_RADIUS
    for pts in collect_pins(cell, layout):
        for e, inner in ((pts[0], pts[1]), (pts[-1], pts[-2])):
            d = dist(click, e)
            if d <= bd:
                v = unit(e.x-inner.x, e.y-inner.y)
                if v:
                    bd = d
                    best = (e, v)
    return best

def bezier(p0, p1, d0, d1):
    c0 = pya.DPoint(p0.x+LEAD*d0[0], p0.y+LEAD*d0[1])
    c1 = pya.DPoint(p1.x+LEAD*d1[0], p1.y+LEAD*d1[1])
    out = []
    for i in range(NPTS+1):
        t = float(i)/NPTS
        u = 1.0-t
        out.append(pya.DPoint(
            u**3*p0.x+3*u*u*t*c0.x+3*u*t*t*c1.x+t**3*p1.x,
            u**3*p0.y+3*u*u*t*c0.y+3*u*t*t*c1.y+t**3*p1.y))
    return out

class Router(pya.Plugin):
    def __init__(self):
        super(Router, self).__init__()
        self.first = None

    def activated(self):
        self.first = None

    def deactivated(self):
        self.first = None

    def mouse_click_event(self, p, buttons, prio):
        if prio: return False
        view = pya.LayoutView.current()
        if view is None: return False
        cv = view.active_cellview()
        if cv is None or not cv.is_valid(): return False
        layout = cv.layout()
        cell = cv.cell
        click = pya.DPoint(p.x, p.y)
        port = nearest_port(cell, layout, click)
        if port is None:
            pya.MainWindow.instance().message("No optical port found", 2000)
            return True
        if self.first is None:
            self.first = port
            pya.MainWindow.instance().message("Source selected - click destination", 2000)
            return True
        p0, d0 = self.first
        p1, d1 = port
        self.first = None
        pts = bezier(p0, p1, d0, d1)
        cell.shapes(layout.layer(WG_LAYER)).insert(pya.DPath(pts, WG_WIDTH))
        view.add_missing_layers()
        pya.MainWindow.instance().message("Waveguide created", 2000)
        return True

class RouterFactory(pya.PluginFactory):
    def __init__(self):
        super(RouterFactory, self).__init__()
        self.register(-1000, "photonics_router_v5_3_2", "Photonics Router v5.3.2")
    def create_plugin(self, manager, root, view):
        return Router()

RouterFactory()
]]></text>
</klayout-macro>
