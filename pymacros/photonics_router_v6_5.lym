<?xml version='1.0' encoding='utf-8'?>
<klayout-macro>
<description>Photonics Router v6.5 - hybrid CSC Euler AUTO GUI</description>
<version>6.5</version>
<category>Photonics</category>
<autorun>true</autorun>
<autorun-early>false</autorun-early>
<show-in-menu>false</show-in-menu>
<interpreter>python</interpreter>
<text>
import pya
import math

WG_LAYER = pya.LayerInfo(1, 0)
OBSTACLE_LAYER = pya.LayerInfo(90, 0)
PIN_LAYER = pya.LayerInfo(2, 0)
WG_WIDTH = 0.5
SNAP_RADIUS = 4.0
MIN_LEAD = 4.0
MAX_LEAD = 20.0
NPTS = 96
CONNECT_TOL = 0.15  # um
MIN_BEND_RADIUS = 5.0  # um, prototype design rule
MAX_TANGENT_ERROR_DEG = 5.0  # allowed port/route tangent error
BEND_OPT_MAX_ITER = 12
BEND_OPT_STEP = 1.15
MID_OFFSET_FACTORS = (0.15, 0.25, 0.35, 0.45)
ARC_ANGLE_STEPS = 36
MAX_TOTAL_TURN_DEG = 240.0
MAX_CSC_SUBTURN_DEG = 200.0
MAX_CSCSC_TOTAL_TURN_DEG = 300.0
MAX_CSCSC_LENGTH_FACTOR = 2.40
MAX_ROUTE_LENGTH_FACTOR = 2.20
RADIUS_MARGIN = 1.25

class PhotonicDevice:
    """Photonic device containing native optical ports."""
    def __init__(self, name, cell_name):
        self.name = name
        self.cell_name = cell_name
        self.ports = []

    def add_port(self, port):
        if port not in self.ports:
            self.ports.append(port)
        port.device = self

    def __repr__(self):
        return "PhotonicDevice(%s, type=%s, ports=%d)" % (
            self.name, self.cell_name, len(self.ports))

class OpticalPort:
    """Optical-port metadata including owning instance identification."""
    def __init__(self, name, position, direction, width=WG_WIDTH,
                 instance_name=None, cell_name=None):
        self.name = name
        self.position = position
        self.direction = direction
        self.width = width
        self.instance_name = instance_name
        self.cell_name = cell_name

        # v6.1 photonic data model
        self.device = None
        self.net = None

    @property
    def qualified_name(self):
        if self.device is not None:
            return "%s.%s" % (self.device.name, self.name)
        if self.instance_name:
            return "%s.%s" % (self.instance_name, self.name)
        return self.name

    def __repr__(self):
        return "OpticalPort(%s, x=%.3f, y=%.3f, width=%.3f)" % (
            self.qualified_name, self.position.x, self.position.y, self.width)

def unit(dx, dy):
    d = math.hypot(dx, dy)
    return None if d &lt; 1e-12 else (dx/d, dy/d)

def dist(a, b):
    return math.hypot(a.x-b.x, a.y-b.y)

def dot(a, b):
    return a[0]*b[0] + a[1]*b[1]

def path_points(path, dbu):
    pts = []
    for q in path.each_point():
        if isinstance(q, pya.DPoint):
            pts.append(q)
        else:
            pts.append(pya.DPoint(q.x*dbu, q.y*dbu))
    return pts

def _safe_cell_name(cell):
    try:
        name = str(cell.name)
    except Exception:
        name = "device"
    # PCell variant names can contain generated suffixes. Keep the visible
    # cell name but remove whitespace so it is convenient in messages.
    return "".join(name.split()) or "device"

def collect_pin_objects(cell, layout, trans=None, result=None,
                        owner=None, cell_name=None):
    """Collect PIN_LAYER paths/texts recursively with instance ownership."""
    if result is None:
        result = {"paths": [], "texts": []}
    if trans is None:
        trans = pya.DCplxTrans()
    if cell_name is None:
        cell_name = _safe_cell_name(cell)

    li = layout.layer(PIN_LAYER)

    for sh in cell.shapes(li).each():
        try:
            if sh.is_path():
                pts = path_points(sh.path, layout.dbu)
                pts = [trans * q for q in pts]
                if len(pts) &gt;= 2:
                    width = sh.path.width * layout.dbu
                    result["paths"].append(
                        (pts, width, owner, cell_name))
            elif sh.is_text():
                t = sh.text
                try:
                    tp = pya.DPoint(t.trans.disp.x * layout.dbu,
                                    t.trans.disp.y * layout.dbu)
                except Exception:
                    tp = pya.DPoint(t.x * layout.dbu, t.y * layout.dbu)
                result["texts"].append(
                    (str(t.string), trans * tp, owner, cell_name))
        except Exception:
            pass

    # Assign a stable, readable identifier to each child instance in this
    # hierarchy level. This does not modify the layout.
    counters = {}
    try:
        for inst in cell.each_inst():
            child = layout.cell(inst.cell_index)
            base = _safe_cell_name(child)
            counters[base] = counters.get(base, 0) + 1
            local_name = "%s[%d]" % (base, counters[base])
            inst_name = local_name if owner is None else "%s/%s" % (
                owner, local_name)

            try:
                it = inst.dcplx_trans
            except Exception:
                it = pya.DCplxTrans(inst.trans)

            collect_pin_objects(
                child, layout, trans * it, result,
                inst_name, base)
    except Exception:
        pass

    return result

def collect_ports(cell, layout):
    """Build native PCell ports and preserve their owning instance."""
    objects = collect_pin_objects(cell, layout)
    paths = objects["paths"]
    texts = objects["texts"]
    ports = []
    match_radius = max(1.5, SNAP_RADIUS)

    for name, label_pos, owner, text_cell_name in texts:
        best = None
        best_d = match_radius

        # Prefer a pin path belonging to the same instance as the label.
        for pts, width, path_owner, path_cell_name in paths:
            if path_owner != owner:
                continue
            for endpoint, inner in ((pts[0], pts[1]), (pts[-1], pts[-2])):
                d = dist(label_pos, endpoint)
                if d &lt;= best_d:
                    best_d = d
                    best = (endpoint, inner, width, path_cell_name)

        if best is None:
            continue

        endpoint, inner, width, path_cell_name = best
        direction = unit(endpoint.x-inner.x, endpoint.y-inner.y)
        if direction is None:
            continue

        ports.append(OpticalPort(
            name, endpoint, direction, width,
            instance_name=owner,
            cell_name=path_cell_name))

    return ports

def nearest_port(cell, layout, click):
    best = None
    bd = SNAP_RADIUS

    for port in collect_ports(cell, layout):
        d = dist(click, port.position)
        if d &lt;= bd:
            bd = d
            best = port
    return best

def polyline_length(pts):
    return sum(dist(pts[i-1], pts[i]) for i in range(1, len(pts)))

def cubic(p0, c0, c1, p1, n):
    out = []
    for i in range(n+1):
        t = float(i)/n
        u = 1.0-t
        out.append(pya.DPoint(
            u*u*u*p0.x + 3*u*u*t*c0.x + 3*u*t*t*c1.x + t*t*t*p1.x,
            u*u*u*p0.y + 3*u*u*t*c0.y + 3*u*t*t*c1.y + t*t*t*p1.y))
    return out

def polyline_has_loop(pts):
    # Fast sanity check: detect strong reversal of successive segments.
    prev = None
    reversals = 0
    for i in range(1, len(pts)):
        v = unit(pts[i].x-pts[i-1].x, pts[i].y-pts[i-1].y)
        if v is None:
            continue
        if prev is not None and dot(prev, v) &lt; -0.15:
            reversals += 1
        prev = v
    return reversals &gt; 0

def angle_between_deg(a, b):
    """Smallest angle between two direction vectors in degrees.

    unit() in this router returns a plain (x, y) tuple, so keep the
    tangent calculation tuple-based as well.
    """
    ua = unit(a[0], a[1])
    ub = unit(b[0], b[1])
    c = max(-1.0, min(1.0, dot(ua, ub)))
    return math.degrees(math.acos(c))


def route_endpoint_tangent_errors(pts, d0, d1):
    """Return tangent errors at source and destination ports.

    d0/d1 are native port directions.  The route tangent must leave the
    source along its port axis and arrive at the destination along its
    port axis.  Axis direction is compared bidirectionally because native
    pin orientation may be stored with either sign.
    """
    if len(pts) &lt; 2:
        return 180.0, 180.0

    t0 = unit(pts[1].x - pts[0].x, pts[1].y - pts[0].y)
    t1 = unit(pts[-1].x - pts[-2].x, pts[-1].y - pts[-2].y)

    def axis_error(t, d):
        # Native port directions are also tuple-based in v6.1/v6.2.
        e1 = angle_between_deg(t, d)
        e2 = angle_between_deg(t, (-d[0], -d[1]))
        return min(e1, e2)

    return axis_error(t0, d0), axis_error(t1, d1)


def tangent_check(pts, d0, d1, tolerance=MAX_TANGENT_ERROR_DEG):
    e0, e1 = route_endpoint_tangent_errors(pts, d0, d1)
    return e0, e1, (e0 &lt;= tolerance and e1 &lt;= tolerance)


def local_bend_radius(a, b, c):
    """Circumcircle radius through three sampled points, in um."""
    ab = dist(a, b)
    bc = dist(b, c)
    ca = dist(c, a)

    if ab &lt; 1e-12 or bc &lt; 1e-12 or ca &lt; 1e-12:
        return None

    area2 = abs(
        (b.x-a.x)*(c.y-a.y) -
        (b.y-a.y)*(c.x-a.x)
    )

    # Nearly collinear points are effectively straight.
    if area2 &lt; 1e-12:
        return None

    return (ab * bc * ca) / (2.0 * area2)


def minimum_bend_radius(pts):
    """Minimum sampled local bend radius. Straight routes return infinity."""
    rmin = float("inf")
    for i in range(1, len(pts)-1):
        r = local_bend_radius(pts[i-1], pts[i], pts[i+1])
        if r is not None and r &lt; rmin:
            rmin = r
    return rmin


def bend_radius_check(pts, required=MIN_BEND_RADIUS):
    rmin = minimum_bend_radius(pts)
    return rmin, rmin &gt;= required


def format_bend_radius(r):
    if math.isinf(r):
        return "INF"
    return "%.3f um" % r


def _route_points_with_lead(p0, p1, d0, d1, lead):
    """Generate one tangent-constrained cubic Bezier using a chosen lead."""
    vx = p1.x - p0.x
    vy = p1.y - p0.y
    D = math.hypot(vx, vy)

    if D &lt; 1e-9:
        return [p0, p1]

    u01 = unit(vx, vy)

    # Preserve the v6.1 direction-sign convention: each port axis is oriented
    # toward the opposite endpoint before building the Bezier controls.
    if dot(d0, u01) &lt; 0:
        d0 = (-d0[0], -d0[1])
    if dot(d1, (-u01[0], -u01[1])) &lt; 0:
        d1 = (-d1[0], -d1[1])

    c0 = pya.DPoint(p0.x + d0[0] * lead, p0.y + d0[1] * lead)
    c1 = pya.DPoint(p1.x + d1[0] * lead, p1.y + d1[1] * lead)
    return cubic(p0, c0, c1, p1, NPTS)


def _oriented_port_dirs(p0, p1, d0, d1):
    """Orient native port axes toward the opposite endpoint."""
    vx = p1.x - p0.x
    vy = p1.y - p0.y
    D = math.hypot(vx, vy)
    if D &lt; 1e-9:
        return d0, d1, (1.0, 0.0), D
    u01 = unit(vx, vy)
    sd0 = d0
    sd1 = d1
    if dot(sd0, u01) &lt; 0:
        sd0 = (-sd0[0], -sd0[1])
    if dot(sd1, (-u01[0], -u01[1])) &lt; 0:
        sd1 = (-sd1[0], -sd1[1])
    return sd0, sd1, u01, D


def _mod2pi(a):
    twopi = 2.0 * math.pi
    return a % twopi


def _sample_pose_arc(x, y, heading, turn, radius, angle, n):
    """Sample an exact L/R circular arc from a pose."""
    pts = [pya.DPoint(x, y)]
    sign = 1.0 if turn == "L" else -1.0
    cx = x - sign * radius * math.sin(heading)
    cy = y + sign * radius * math.cos(heading)
    a0 = math.atan2(y - cy, x - cx)
    for i in range(1, n + 1):
        da = sign * angle * float(i) / float(n)
        a = a0 + da
        pts.append(pya.DPoint(cx + radius * math.cos(a),
                              cy + radius * math.sin(a)))
    h1 = heading + sign * angle
    return pts, pts[-1].x, pts[-1].y, h1


def _dubins_words(alpha, beta, d):
    """Return normalized CSC Dubins candidates: LSL, RSR, LSR, RSL."""
    out = []

    # LSL
    tmp0 = d + math.sin(alpha) - math.sin(beta)
    p2 = 2 + d*d - 2*math.cos(alpha-beta) + 2*d*(math.sin(alpha)-math.sin(beta))
    if p2 &gt;= 0:
        tmp1 = math.atan2(math.cos(beta)-math.cos(alpha), tmp0)
        t = _mod2pi(-alpha + tmp1)
        p = math.sqrt(p2)
        q = _mod2pi(beta - tmp1)
        out.append(("LSL", t, p, q))

    # RSR
    tmp0 = d - math.sin(alpha) + math.sin(beta)
    p2 = 2 + d*d - 2*math.cos(alpha-beta) + 2*d*(-math.sin(alpha)+math.sin(beta))
    if p2 &gt;= 0:
        tmp1 = math.atan2(math.cos(alpha)-math.cos(beta), tmp0)
        t = _mod2pi(alpha - tmp1)
        p = math.sqrt(p2)
        q = _mod2pi(-beta + tmp1)
        out.append(("RSR", t, p, q))

    # LSR
    p2 = -2 + d*d + 2*math.cos(alpha-beta) + 2*d*(math.sin(alpha)+math.sin(beta))
    if p2 &gt;= 0:
        p = math.sqrt(p2)
        tmp2 = math.atan2(-math.cos(alpha)-math.cos(beta),
                          d + math.sin(alpha)+math.sin(beta)) - math.atan2(-2.0, p)
        t = _mod2pi(-alpha + tmp2)
        q = _mod2pi(-beta + tmp2)
        out.append(("LSR", t, p, q))

    # RSL
    p2 = d*d - 2 + 2*math.cos(alpha-beta) - 2*d*(math.sin(alpha)+math.sin(beta))
    if p2 &gt;= 0:
        p = math.sqrt(p2)
        tmp2 = math.atan2(math.cos(alpha)+math.cos(beta),
                          d - math.sin(alpha)-math.sin(beta)) - math.atan2(2.0, p)
        t = _mod2pi(alpha - tmp2)
        q = _mod2pi(beta - tmp2)
        out.append(("RSL", t, p, q))

    return out


def _dubins_candidate(p0, p1, d0, d1, radius, word, t, p, q):
    """Generate one CSC Dubins path in layout coordinates."""
    h0 = math.atan2(d0[1], d0[0])
    x, y, h = p0.x, p0.y, h0
    pts = [p0]

    turn0 = word[0]
    turn1 = word[2]

    a, x, y, h = _sample_pose_arc(x, y, h, turn0, radius, t, ARC_ANGLE_STEPS)
    pts += a[1:]

    # Straight section, normalized p times radius.
    slen = p * radius
    x += slen * math.cos(h)
    y += slen * math.sin(h)
    pts.append(pya.DPoint(x, y))

    a, x, y, h = _sample_pose_arc(x, y, h, turn1, radius, q, ARC_ANGLE_STEPS)
    pts += a[1:]

    # Numerical closure check.
    pos_err = math.hypot(x - p1.x, y - p1.y)
    h1 = math.atan2(d1[1], d1[0])
    heading_err = abs(math.atan2(math.sin(h-h1), math.cos(h-h1)))
    if pos_err &gt; max(0.02, 5.0e-3 * radius):
        return None
    if math.degrees(heading_err) &gt; MAX_TANGENT_ERROR_DEG:
        return None

    pts[-1] = p1
    return pts


def _directed_angle_error(u, v):
    """Directed tangent error in degrees. Opposite vectors are 180 deg."""
    uu = unit(u[0], u[1])
    vv = unit(v[0], v[1])
    c = max(-1.0, min(1.0, dot(uu, vv)))
    return math.degrees(math.acos(c))


def strict_native_tangent_check(pts, src_dir, dst_dir):
    """Check route tangents against the native PCell port directions.

    Source: route must leave the source along its native outward direction.
    Destination: route must arrive opposite to the destination outward
    direction.  No automatic direction flipping is allowed.
    """
    if len(pts) &lt; 2:
        return 180.0, 180.0, False

    s = (pts[1].x - pts[0].x, pts[1].y - pts[0].y)
    e = (pts[-1].x - pts[-2].x, pts[-1].y - pts[-2].y)

    src_err = _directed_angle_error(s, src_dir)
    dst_inward = (-dst_dir[0], -dst_dir[1])
    dst_err = _directed_angle_error(e, dst_inward)

    ok = (src_err &lt;= MAX_TANGENT_ERROR_DEG and
          dst_err &lt;= MAX_TANGENT_ERROR_DEG)
    return src_err, dst_err, ok


def optimize_bend_aware_route(p0, p1, d0, d1):
    """Photonic route search: compact CSC first, then waypoint CSCSC.

    The fallback adds one tangent-continuous intermediate waypoint.  Each
    half is an exact constant-radius Dubins CSC route, so no sharp join is
    introduced at the waypoint.
    """
    vx = p1.x - p0.x
    vy = p1.y - p0.y
    D = math.hypot(vx, vy)
    if D &lt; 1e-9:
        return (None, 0.0, False, 180.0, 180.0, False,
                False, 0, False, "NO_LEGAL_ROUTE")

    chord = (vx / D, vy / D)
    normal = (-chord[1], chord[0])
    route_start_dir = d0
    route_end_dir = (-d1[0], -d1[1])
    evaluated = []

    def evaluate(pts, variant, designed_radius, length_factor):
        if pts is None or len(pts) &lt; 2:
            return
        if polyline_has_loop(pts):
            return
        plen = polyline_length(pts)
        if plen &gt; length_factor * D:
            return

        measured_rmin, _ = bend_radius_check(pts)
        bend_ok = designed_radius + 1e-9 &gt;= MIN_BEND_RADIUS
        e0, e1, tangent_ok = strict_native_tangent_check(pts, d0, d1)
        geometry_ok = bend_ok and tangent_ok

        evaluated.append((pts, measured_rmin, bend_ok, e0, e1,
                          tangent_ok, geometry_ok, plen, True, variant))

    def dubins_between(a, b, h0, h1, radius, max_total_turn):
        """Return legal constant-radius CSC alternatives between two poses."""
        dx = b.x - a.x
        dy = b.y - a.y
        DD = math.hypot(dx, dy)
        if DD &lt; 1e-9:
            return []

        theta = math.atan2(dy, dx)
        alpha = _mod2pi(math.atan2(h0[1], h0[0]) - theta)
        beta = _mod2pi(math.atan2(h1[1], h1[0]) - theta)
        dd = DD / radius
        result = []

        for word, t, p, q in _dubins_words(alpha, beta, dd):
            turn_deg = math.degrees(t + q)
            if turn_deg &gt; max_total_turn:
                continue
            pts = _dubins_candidate(a, b, h0, h1,
                                    radius, word, t, p, q)
            if pts is None or len(pts) &lt; 2:
                continue
            if polyline_has_loop(pts):
                continue
            result.append((pts, word, turn_deg, polyline_length(pts)))
        return result

    radii = (MIN_BEND_RADIUS * RADIUS_MARGIN,
             MIN_BEND_RADIUS * 1.50,
             MIN_BEND_RADIUS * 1.75,
             MIN_BEND_RADIUS * 2.00)

    # Stage 1: ordinary compact CSC.
    for radius in radii:
        for pts, word, turn_deg, plen in dubins_between(
                p0, p1, route_start_dir, route_end_dir,
                radius, MAX_TOTAL_TURN_DEG):
            evaluate(pts, "PHOTONIC_" + word,
                     radius, MAX_ROUTE_LENGTH_FACTOR)

    legal_csc = [c for c in evaluated if c[6]]
    if legal_csc:
        best_csc = min(legal_csc, key=lambda c: c[7])
        # Keep a genuinely compact direct CSC immediately.
        if best_csc[7] &lt;= 1.65 * D:
            (pts, rmin, bend_ok, e0, e1, tangent_ok,
             geometry_ok, plen, optimized, variant) = best_csc
            return (pts, rmin, bend_ok, e0, e1, tangent_ok,
                    geometry_ok, len(evaluated), optimized, variant)

    # Stage 2: tangent-continuous waypoint fallback.
    # Search both sides of the chord and several waypoint headings.  This
    # supplies the extra degree of freedom needed for compact S-like routes.
    base_angle = math.atan2(chord[1], chord[0])
    heading_offsets_deg = (-75.0, -60.0, -45.0, -30.0, -15.0, 0.0,
                           15.0, 30.0, 45.0, 60.0, 75.0)
    lateral_scales = (-0.60, -0.45, -0.30, -0.15, 0.0,
                      0.15, 0.30, 0.45, 0.60)
    longitudinal_scales = (0.30, 0.40, 0.50, 0.60, 0.70)

    for radius in radii:
        before_count = len(evaluated)

        for ls in longitudinal_scales:
            for ns in lateral_scales:
                mid = pya.DPoint(
                    p0.x + ls * vx + ns * D * normal[0],
                    p0.y + ls * vy + ns * D * normal[1])

                for hoff in heading_offsets_deg:
                    ang = base_angle + math.radians(hoff)
                    hm = (math.cos(ang), math.sin(ang))

                    first = dubins_between(
                        p0, mid, route_start_dir, hm,
                        radius, MAX_CSC_SUBTURN_DEG)
                    second = dubins_between(
                        mid, p1, hm, route_end_dir,
                        radius, MAX_CSC_SUBTURN_DEG)

                    for a_pts, a_word, a_turn, a_len in first:
                        for b_pts, b_word, b_turn, b_len in second:
                            if a_turn + b_turn &gt; MAX_CSCSC_TOTAL_TURN_DEG:
                                continue

                            pts = a_pts[:-1] + b_pts
                            variant = "CSCSC_%s_%s_R%.2f" % (
                                a_word, b_word, radius)
                            evaluate(pts, variant, radius,
                                     MAX_CSCSC_LENGTH_FACTOR)

        # Radius-first strategy: once this radius produces a legal CSCSC
        # candidate, do not enlarge the bend radius unnecessarily.
        new_candidates = evaluated[before_count:]
        if any(c[6] for c in new_candidates):
            break

    legal = [c for c in evaluated if c[6]]
    if not legal:
        return (None, 0.0, False, 180.0, 180.0, False,
                False, len(evaluated), False, "NO_LEGAL_ROUTE")

    # Prefer the shortest legal route across CSC and waypoint candidates.
    best = min(legal, key=lambda c: c[7])
    (pts, rmin, bend_ok, e0, e1, tangent_ok,
     geometry_ok, plen, optimized, variant) = best

    return (pts, rmin, bend_ok, e0, e1, tangent_ok,
            geometry_ok, len(evaluated), optimized, variant)


def route_points(p0, p1, d0, d1):
    """
    v5.5 routing core (inherited from v5.4):
      * automatically scale lead length with port spacing
      * prefer directions that point toward the opposite port
      * if a single cubic looks folded, fall back to a midpoint route
    """
    D = dist(p0, p1)
    if D &lt; 1e-9:
        return [p0, p1]

    toward01 = unit(p1.x-p0.x, p1.y-p0.y)
    toward10 = (-toward01[0], -toward01[1])

    # A physical connection leaves each optical interface into free routing
    # space.  Depending on how the PCell pin path was drawn, the detected
    # vector can be reversed. Choose the sign which points more toward the
    # other endpoint. This prevents the common large-loop case.
    if dot(d0, toward01) &lt; dot((-d0[0], -d0[1]), toward01):
        d0 = (-d0[0], -d0[1])
    if dot(d1, toward10) &lt; dot((-d1[0], -d1[1]), toward10):
        d1 = (-d1[0], -d1[1])

    lead = max(MIN_LEAD, min(MAX_LEAD, 0.28*D))

    c0 = pya.DPoint(p0.x + lead*d0[0], p0.y + lead*d0[1])
    # Endpoint derivative is p1-c1, therefore c1 lies opposite the
    # desired arrival tangent.
    c1 = pya.DPoint(p1.x + lead*d1[0], p1.y + lead*d1[1])

    pts = cubic(p0, c0, c1, p1, NPTS)

    # Additional geometric guard: an excessive route length usually means
    # the cubic is making an unwanted detour/loop.
    plen = sum(dist(pts[i-1], pts[i]) for i in range(1, len(pts)))
    if not polyline_has_loop(pts) and plen &lt;= 1.65*D:
        return pts

    # Fallback: two smooth cubic sections through a neutral midpoint.
    # This avoids forcing incompatible endpoint tangents into one cubic.
    mid = pya.DPoint((p0.x+p1.x)/2.0, (p0.y+p1.y)/2.0)
    md = toward01
    half = max(MIN_LEAD, min(MAX_LEAD, 0.18*D))

    a0 = pya.DPoint(p0.x + half*d0[0], p0.y + half*d0[1])
    a1 = pya.DPoint(mid.x - half*md[0], mid.y - half*md[1])
    b0 = pya.DPoint(mid.x + half*md[0], mid.y + half*md[1])
    b1 = pya.DPoint(p1.x + half*d1[0], p1.y + half*d1[1])

    left = cubic(p0, a0, a1, mid, NPTS//2)
    right = cubic(mid, b0, b1, p1, NPTS//2)
    return left + right[1:]


def collect_waveguide_paths(cell, layout, trans=None, result=None):
    """Collect WG_LAYER paths recursively in top-cell coordinates."""
    if result is None:
        result = []
    if trans is None:
        trans = pya.DCplxTrans()

    li = layout.layer(WG_LAYER)
    for sh in cell.shapes(li).each():
        try:
            if sh.is_path():
                pts = path_points(sh.path, layout.dbu)
                pts = [trans * q for q in pts]
                if len(pts) &gt;= 2:
                    result.append(pts)
        except Exception:
            pass

    try:
        for inst in cell.each_inst():
            child = layout.cell(inst.cell_index)
            try:
                it = inst.dcplx_trans
            except Exception:
                it = pya.DCplxTrans(inst.trans)
            collect_waveguide_paths(child, layout, trans * it, result)
    except Exception:
        pass
    return result

class PhotonicNet:
    """Extracted photonic net connecting optical ports."""
    def __init__(self, name, ports, length=0.0, min_bend_radius=None,
                 required_bend_radius=MIN_BEND_RADIUS):
        self.name = name
        self.ports = list(ports)
        self.length = length
        self.min_bend_radius = min_bend_radius
        self.required_bend_radius = required_bend_radius
        self.bend_check = (
            None if min_bend_radius is None
            else min_bend_radius &gt;= required_bend_radius
        )

        # v6.1+: establish Port &lt;-&gt; Net relationship
        for port in self.ports:
            port.net = self

    def __repr__(self):
        return "PhotonicNet(%s, ports=%s, length=%.3f)" % (
            self.name,
            [p.qualified_name for p in self.ports],
            self.length)

def ports_at_point(ports, point, tol=CONNECT_TOL):
    return [p for p in ports if dist(p.position, point) &lt;= tol]

def extract_connection_pairs(cell, layout):
    """Extract routed optical-port pairs from WG path endpoints."""
    ports = collect_ports(cell, layout)
    wg_paths = collect_waveguide_paths(cell, layout)
    pairs = []
    seen = set()

    for pts in wg_paths:
        if len(pts) &lt; 2:
            continue
        a_ports = ports_at_point(ports, pts[0])
        b_ports = ports_at_point(ports, pts[-1])

        for a in a_ports:
            for b in b_ports:
                if a is b or a.instance_name == b.instance_name:
                    continue
                names = tuple(sorted((a.qualified_name, b.qualified_name)))
                if names in seen:
                    continue
                seen.add(names)
                pairs.append((a, b, polyline_length(pts)))

    return ports, pairs

def build_photonic_devices(ports):
    """Build PhotonicDevice objects and link them to OpticalPort objects."""
    devices = {}
    for p in ports:
        if not p.instance_name:
            continue
        if p.instance_name not in devices:
            devices[p.instance_name] = PhotonicDevice(
                p.instance_name, p.cell_name)
        devices[p.instance_name].add_port(p)
    return devices

def extract_photonic_netlist(cell, layout):
    """Build PhotonicDevice -&gt; OpticalPort -&gt; PhotonicNet relationships."""
    ports, pairs = extract_connection_pairs(cell, layout)

    # Build Device &lt;-&gt; Port relationships first.
    devices = build_photonic_devices(ports)

    # Then build Port &lt;-&gt; Net relationships.
    nets = []
    for i, (a, b, length) in enumerate(pairs, 1):
        nets.append(PhotonicNet("NET%d" % i, [a, b], length))

    return ports, devices, nets

def verify_connectivity(cell, layout):
    ports, devices, nets = extract_photonic_netlist(cell, layout)
    connected_names = set()
    for net in nets:
        for p in net.ports:
            connected_names.add(p.qualified_name)

    connected = [p for p in ports if p.qualified_name in connected_names]
    unconnected = [p for p in ports if p.qualified_name not in connected_names]
    return connected, unconnected, devices, nets

def netlist_report(cell, layout):
    connected, unconnected, devices, nets = verify_connectivity(cell, layout)

    lines = [
        "[Photonics Router v6.2 Photonic Data Model]",
        "Devices: %d" % len(devices),
        "Nets: %d" % len(nets),
        "Connected ports: %d" % len(connected),
        "Unconnected ports: %d" % len(unconnected),
        "",
        "DEVICES",
    ]

    for inst_name in sorted(devices):
        device = devices[inst_name]
        lines.append("  DEVICE %s  TYPE %s" % (
            device.name, device.cell_name))

    if nets:
        lines.append("")
        lines.append("NETLIST")
        for net in nets:
            lines.append("  NET %s" % net.name)
            for p in net.ports:
                lines.append("    PORT %s" % p.qualified_name)
            lines.append("    LENGTH %.3f um" % net.length)

    if unconnected:
        lines.append("")
        lines.append("UNCONNECTED")
        for p in unconnected:
            lines.append("  --  %s" % p.qualified_name)

    return "\n".join(lines)

# Compatibility name used by the Router UI.
def connectivity_report(cell, layout):
    return netlist_report(cell, layout)

import sys
_PDK_ROOT = '/home/take/Photonics/klayout-photonics-pdk'
if _PDK_ROOT not in sys.path:
    sys.path.insert(0, _PDK_ROOT)


# Shared activation owner across all three v6.5 plugin instances.
_v65_active_router = None

class HybridRouter(pya.Plugin):
    """Two-click hybrid router. Mode is selected by activating a tool."""
    def __init__(self, mode):
        super(HybridRouter, self).__init__()
        self.mode = mode
        self.first = None

    def activated(self):
        global _v65_active_router
        _v65_active_router = self
        self.first = None
        print('[v6.5 ACTIVATED] mode=%s instance=%s' % (self.mode, id(self)), flush=True)
        self._status('Photonics Router v6.5 [%s]: click source optical port' % self.mode)

    def deactivated(self):
        global _v65_active_router
        if _v65_active_router is self:
            _v65_active_router = None
        print('[v6.5 DEACTIVATED] mode=%s instance=%s' % (self.mode, id(self)), flush=True)
        self.first = None

    @staticmethod
    def _status(message):
        try:
            pya.MainWindow.instance().message(message, 4000)
        except Exception:
            print(message)

    @staticmethod
    def _warning(message):
        print(message)
        try:
            pya.MessageBox.warning('Photonics Router v6.5', message, pya.MessageBox.Ok)
        except Exception:
            pass

    def mouse_click_event(self, p, buttons, prio):
        print('[v6.5 CLICK] mode=%s instance=%s prio=%s x=%.3f y=%.3f' %
              (self.mode, id(self), prio, p.x, p.y), flush=True)
        # In KLayout prio=True may belong to the selected plugin.
        # Never let inactive plugins steal the click when prio=False.
        if _v65_active_router is not self:
            return False
        view = pya.LayoutView.current()
        if view is None:
            return False
        cv = view.active_cellview()
        if cv is None or not cv.is_valid():
            return False
        layout, cell = cv.layout(), cv.cell
        port = nearest_port(cell, layout, pya.DPoint(p.x, p.y))
        if port is None:
            self._status('No optical port within %.1f um' % SNAP_RADIUS)
            return True
        if self.first is None:
            self.first = port
            self._status('[%s] Source %s: click destination' %
                         (self.mode, port.qualified_name))
            return True
        source, destination = self.first, port
        self.first = None
        print('[v6.5 ROUTE] mode=%s source=%s destination=%s' %
              (self.mode, source.qualified_name, destination.qualified_name), flush=True)
        if source.qualified_name == destination.qualified_name:
            self._warning('SAME_PORT_SELECTED')
            return True
        try:
            from photonics.pdk.cross_section import WaveguideCrossSection
            from photonics.pdk.design_rules import DesignRules
            from photonics.integration.router_hybrid_v65 import route_between_ports_hybrid
            width = float(source.width)
            xs = WaveguideCrossSection('strip', width, MIN_BEND_RADIUS)
            rules = DesignRules(0.4, 0.5, MIN_BEND_RADIUS)
            result = route_between_ports_hybrid(
                cell, layout, source, destination, xs, rules,
                mode=self.mode, waveguide_layer=WG_LAYER,
                obstacle_layer=OBSTACLE_LAYER)
        except Exception as exc:
            print('[v6.5 EXCEPTION] mode=%s error=%r' % (self.mode, exc), flush=True)
            self._warning('Routing rejected [%s]: %s' % (self.mode, exc))
            return True
        print('[v6.5 RESULT] mode=%s valid=%s variant=%s reason=%s' %
              (self.mode, result.valid, result.variant, result.reason), flush=True)
        if not result.valid:
            self._warning('No route created [%s]: %s' %
                          (self.mode, result.reason))
            return True
        try:
            view.add_missing_layers()
        except Exception:
            pass
        msg = ('%s -> %s\nMode: %s\nTopology: %s\nLength: %.3f um\n'
               'Designed radius: %.3f um\nSampled radius: %s\n'
               'Source tangent error: %.3f deg\n'
               'Destination tangent error: %.3f deg' %
               (source.qualified_name, destination.qualified_name,
                self.mode, result.variant, result.length_um,
                result.designed_radius_um,
                format_bend_radius(result.measured_radius_um),
                result.tangent_error_source_deg,
                result.tangent_error_destination_deg))
        print('[Photonics Router v6.5]\n' + msg)
        self._status('Route created [%s]: %.3f um (%s)' %
                     (self.mode, result.length_um, result.variant))
        try:
            pya.MessageBox.info('Photonics Router v6.5', msg, pya.MessageBox.Ok)
        except Exception:
            pass
        return True


class HybridRouterFactory(pya.PluginFactory):
    def __init__(self, mode, plugin_id, priority):
        super(HybridRouterFactory, self).__init__()
        self.mode = mode
        self.register(priority, plugin_id,
                      'Photonics Router v6.5 ' + mode)

    def create_plugin(self, manager, root, view):
        return HybridRouter(self.mode)


# Four independent toolbar tools provide explicit, persistent mode selection.
# Keep factory objects alive for the lifetime of the macro.
_hybrid_router_factories = [
    HybridRouterFactory('AUTO', 'photonics_router_v6_5_auto', -1011),
    HybridRouterFactory('CSC', 'photonics_router_v6_5_csc', -1012),
    HybridRouterFactory('EULER', 'photonics_router_v6_5_euler', -1013),
    HybridRouterFactory('AUTO_QUALITY', 'photonics_router_v6_5_auto_quality', -1014),
]

