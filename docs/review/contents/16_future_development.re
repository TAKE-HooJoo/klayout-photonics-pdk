│   ├── pin_io.py           # Pin Path/Textの読み書き
│   └── transforms.py       # 回転・鏡映・階層変換
├── pcells/
│   ├── straight.py
│   ├── bend90.py
│   ├── euler_bend.py
│   ├── sbend.py
│   ├── ring.py
│   ├── directional_coupler.py
│   ├── mmi_1x2.py
│   ├── mzi.py
│   ├── waveguide_route.py
│   └── port_connector.py
├── integration/
│   ├── router_adapter.py
│   └── netlist_adapter.py
